{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dated price evidence",
  "type": "object",
  "required": [
    "observation_id",
    "store_id",
    "listing_id",
    "amount_decimal",
    "currency",
    "price_basis",
    "channel",
    "observed_at",
    "retrieved_at",
    "source_id",
    "source_record_id",
    "current_stock_inferred"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "store_id": {
      "type": "string",
      "minLength": 1
    },
    "listing_id": {
      "type": "string",
      "minLength": 1
    },
    "amount_decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "price_basis": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "in_store",
        "pickup",
        "delivery",
        "marketplace",
        "unknown"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "object"
    },
    "current_stock_inferred": {
      "const": false
    }
  },
  "additionalProperties": true
}
