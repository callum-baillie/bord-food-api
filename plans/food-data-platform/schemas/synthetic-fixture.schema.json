{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline test scenario",
  "type": "object",
  "required": [
    "fixture_kind",
    "synthetic",
    "network_allowed",
    "scenario"
  ],
  "properties": {
    "fixture_kind": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "network_allowed": {
      "const": false
    },
    "scenario": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
