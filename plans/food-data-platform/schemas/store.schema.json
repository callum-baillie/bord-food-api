{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Store location example",
  "type": "object",
  "required": [
    "entity_type",
    "store_id",
    "chain_id",
    "name",
    "external_ids",
    "address",
    "coordinates",
    "contact",
    "opening_hours",
    "provenance"
  ],
  "properties": {
    "entity_type": {
      "const": "store_location"
    },
    "store_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_status": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "title": "Address",
      "type": "object",
      "required": [
        "line_1",
        "city",
        "region_code",
        "postal_code",
        "country_code"
      ],
      "properties": {
        "line_1": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "line_2": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "region_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "country_code": {
          "const": "US"
        }
      },
      "additionalProperties": true
    },
    "coordinates": {
      "title": "Coordinates",
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "status"
      ],
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "contact": {
      "title": "Contact",
      "type": "object",
      "required": [
        "phone_e164"
      ],
      "properties": {
        "phone_e164": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        }
      },
      "additionalProperties": true
    },
    "opening_hours": {
      "title": "Regular hours",
      "type": "object",
      "required": [
        "timezone",
        "weekly",
        "date_exceptions_status"
      ],
      "properties": {
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone_basis": {
          "type": "string",
          "minLength": 1
        },
        "weekly": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "days",
              "opens",
              "closes",
              "end_day_offset"
            ],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "MO",
                    "TU",
                    "WE",
                    "TH",
                    "FR",
                    "SA",
                    "SU"
                  ]
                }
              },
              "opens": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "closes": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end_day_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "date_exceptions": {
          "type": [
            "array",
            "null"
          ]
        },
        "date_exceptions_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
