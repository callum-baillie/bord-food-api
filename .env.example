# Optional local API key. Blank disables authentication.
API_KEY=
# Keep all four, or choose e.g. branded only.
DATASETS=branded,foundation,fndds,sr_legacy
# Worker imports local USDA files first and pins them. Otherwise managed USDA updates are enabled.
# This legacy switch controls USDA only; use an offline policy to disable ALL source network.
AUTO_DOWNLOAD=true
HOST_PORT=8081

# Optional operator policy path, mounted at the same path in API and worker containers.
# BORD_FOOD_CONFIG=/config/food-policy.json
